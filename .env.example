# ============================================================================
# FreshFlow AI — Environment Variables
# ============================================================================
# Copy this file to .env and customise as needed:
#   cp .env.example .env   (Linux/Mac)
#   Copy-Item .env.example .env   (PowerShell)
# ============================================================================

# ---------- General ---------------------------------------------------------
FRESHFLOW_ENV=development
COMPOSE_PROJECT_NAME=freshflow

# ---------- PostgreSQL ------------------------------------------------------
POSTGRES_USER=freshflow_admin
POSTGRES_PASSWORD=freshflow_dev_2026
POSTGRES_DB=freshflow_db
POSTGRES_PORT=5432

# ---------- MinIO (S3-compatible object store) ------------------------------
MINIO_ROOT_USER=freshflow_minio
MINIO_ROOT_PASSWORD=freshflow_minio_secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- Apache Airflow --------------------------------------------------
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://freshflow_admin:freshflow_dev_2026@postgres:5432/freshflow_db
AIRFLOW_FERNET_KEY=          # Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@freshflow.ai
AIRFLOW_WEBSERVER_PORT=8080

# ---------- MLflow ----------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
MLFLOW_PORT=5000
AWS_ACCESS_KEY_ID=freshflow_minio
AWS_SECRET_ACCESS_KEY=freshflow_minio_secret

# ---------- FastAPI ---------------------------------------------------------
FASTAPI_PORT=8000

# ---------- Spark -----------------------------------------------------------
SPARK_MASTER_WEBUI_PORT=8081

# ---------- Redpanda (Kafka-compatible) -------------------------------------
REDPANDA_KAFKA_PORT=19092
REDPANDA_CONSOLE_PORT=8082

# ---------- Monitoring ------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
